# Application
PORT=5000
NODE_ENV=development

# Frontend
CLIENT_URL=http://localhost:5173

# Background jobs
RUN_BACKGROUND_JOBS=true

# PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=stockvision
DB_PORT=5432

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# AI
GEMINI_API_KEY=your_gemini_api_key

# Market data
FMP_API_KEY=your_fmp_api_key

# Stock data refresh
RUN_MARKET_SYNC_ON_STARTUP=false
RUN_FUNDAMENTAL_SYNC_ON_STARTUP=false

# API request spacing in milliseconds
STOCK_REQUEST_DELAY_MS=1200

# Every hour
MARKET_REFRESH_CRON=0 * * * *

# Sunday at 02:30
FUNDAMENTAL_REFRESH_CRON=30 2 * * 0